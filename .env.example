# ===== LLM (Ollama) =====
OLLAMA_HOST=http://ollama:11434
# Gemma 4 tag. Confirm the exact tag on https://ollama.com/library
# Examples: gemma4, gemma4:latest, gemma4:27b
LLM_MODEL=gemma4:latest
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=8192

# ===== Embedding (Text Embeddings Inference / TEI) =====
TEI_URL=http://tei:80
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# Default is CPU TEI (works everywhere, including Volta/V100 which has no GPU build).
# For newer GPUs, switch to a matching tag and re-enable GPU in docker-compose.yml.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.5

# ===== Vector DB (Qdrant) =====
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rinri_books

# ===== Retrieval =====
RAG_TOP_K=6
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://api:8000
