# ===== LLM (Ollama) =====
OLLAMA_HOST=http://ollama:11434
# Gemma 4 tag. Confirm the exact tag on https://ollama.com/library
# Examples: gemma4, gemma4:latest, gemma4:27b
LLM_MODEL=gemma4:latest
LLM_TEMPERATURE=0.2
# Larger ctx is needed when RAG_TOP_K * RAG_CHUNK_SIZE grows. 16384 fits the
# recommended retrieval params below comfortably; on V100 32GB the extra KV
# cache is a few GB at most.
LLM_NUM_CTX=16384

# ===== Embedding (Text Embeddings Inference / TEI) =====
TEI_URL=http://tei:80
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# Default is CPU TEI (works everywhere, including Volta/V100 which has no GPU build).
# For newer GPUs, switch to a matching tag and re-enable GPU in docker-compose.yml.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.7

# ===== Vector DB (Qdrant) =====
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rinri_books

# ===== Retrieval =====
# Tuned for the cleaned + chapter-split corpus. Increase TOP_K when many
# chunks are short; raise CHUNK_SIZE/OVERLAP when answers need broader
# context within a single passage.
RAG_TOP_K=12
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://api:8000
